    "rows": [
      {
        "display": "flex",
        "columnGap": "12px",
        "fontSize": "13px",
        "padding": "0px",
        "borderBottom": "0px none rgb(36, 36, 36)",
        "leaves": [
          {
            "fontSize": "13px",
            "fontWeight": "400",
            "color": "rgb(36, 36, 36)",
            "padding": "0px",
            "borderBottom": "0px none rgb(36, 36, 36)",
            "text": "Cookie Inspection Limits 001"
          }
        ]
      }
    ]
  }
