[
  {
    "card": {
      "padding": "8px 16px 0px",
      "backgroundColor": "rgb(250, 250, 250)",
      "borderRadius": "12px",
      "marginTop": "10px",
      "display": "flex",
      "flexDirection": "column",
      "rowGap": "12px"
    },
    "header": {
      "display": "flex",
      "alignItems": "center",
      "justifyContent": "space-between",
      "columnGap": "12px",
      "marginBottom": "0px"
