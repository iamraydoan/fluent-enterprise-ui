npx lint-staged || exit 1
staged_src=$(git diff --cached --name-only --diff-filter=ACM -- 'src/*')
if [ -n "$staged_src" ]; then
  if echo "$staged_src" | xargs grep -l "eslint-disable\|@ts-ignore\|@ts-nocheck\|prettier-ignore" > /dev/null 2>&1; then
    echo "Blocked: bypass comment found in staged src files"
    exit 1
  fi
fi
