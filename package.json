{
  "dependencies": {
    "@fluentui/react-components": "^9.75.0",
    "@fluentui/react-icons": "^2.0.344",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^8.21.3",
    "i18next": "^26.5.11",
    "msw": "^3.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.28.0",
    "@tanstack/eslint-plugin-query": "^5.105.0",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser": "2.1.9",
    "@vitest/coverage-v8": "2.1.9",
    "@vitest/ui": "2.1.9",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-import-x": "^4.10.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "husky": "^9.1.7",
    "knip": "^6.43.0",
    "lint-staged": "^15.5.0",
    "playwright": "^1.64.1",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.33.0",
    "vite": "^5.4.11",
    "vitest": "2.1.9",
    "vitest-browser-react": "0.2.0"
  },
  "lint-staged": {
    "*.{json,md,js}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "name": "fluent-enterprise-ui",
  "private": true,
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:deps": "depcruise src",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:browser": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser:install": "playwright install chromium --with-deps"
  },
  "type": "module",
  "version": "1.0.0",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
